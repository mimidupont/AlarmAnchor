# Copy to .env.distribution (gitignored) and fill in the real values:
#
#   cp .env.distribution.example .env.distribution
#
# Firebase App ID: console → Project settings → General → your Android app.
FIREBASE_APP_ID=1:000000000000:android:0000000000000000000000

# Tester group alias from App Distribution → Testers & Groups.
FIREBASE_GROUPS=crew

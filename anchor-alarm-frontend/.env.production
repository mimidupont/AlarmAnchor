# Production configuration, baked in at build time (npm run build).
# Local development keeps using http://localhost:5000 via the code default.

# Backend (Fly.io, single always-on machine — see anchor-alarm-backend/DEPLOY_FLY.md)
REACT_APP_BACKEND_URL=https://alarmanchor-backend.fly.dev

# Public URL of the hosted frontend, used as the base of the QR join link.
# Set this to your Vercel production domain so QR codes scanned by a stock
# camera app open a reachable page (the Capacitor webview's own origin is
# not shareable). Falls back to window.location.origin when unset.
# REACT_APP_FRONTEND_URL=https://your-app.vercel.app

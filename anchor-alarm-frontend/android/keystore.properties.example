# Copy to keystore.properties (gitignored) and fill in the real values:
#
#   cp keystore.properties.example keystore.properties
#
# The keystore itself lives OUTSIDE the repository on purpose, so it cannot be
# committed by accident no matter what .gitignore says. Use an absolute path.
#
# Forward slashes are required even on Windows: a backslash is an escape
# character in a .properties file, so C:\Users\... silently parses wrong.
#
#   Windows : C:/Users/you/Keystores/anchor-alarm-upload.jks
#   macOS   : /Users/you/Keystores/anchor-alarm-upload.jks
#   Linux   : /home/you/Keystores/anchor-alarm-upload.jks
storeFile=C:/Users/you/Keystores/anchor-alarm-upload.jks
storePassword=CHANGEME
keyAlias=anchor-alarm-upload
keyPassword=CHANGEME

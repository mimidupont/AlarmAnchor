# Copy to keystore.properties (gitignored) and fill in the real values
# from the keystore you generated with keytool.
#
#   cp keystore.properties.example keystore.properties
#
# storeFile is resolved relative to anchor-alarm-frontend/android/.
storeFile=../anchor-alarm-release.jks
storePassword=CHANGEME
keyAlias=anchor-alarm
keyPassword=CHANGEME

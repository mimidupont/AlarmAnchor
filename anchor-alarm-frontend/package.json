{
  "name": "anchor-alarm-frontend",
  "version": "1.0.0",
  "description": "Real-time boat anchor alarm monitoring app",
  "private": true,
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/geolocation": "^8.2.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/local-notifications": "^8.2.1",
    "@capacitor/preferences": "^8.0.1",
    "leaflet": "^1.9.4",
    "leaflet-draw": "^1.0.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "socket.io-client": "^4.5.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false",
    "test:watch": "react-scripts test",
    "eject": "react-scripts eject",
    "android:prepare": "npm run build && npx cap sync android",
    "android": "npm run android:prepare && npx cap open android",
    "release:android": "npm run android:prepare && bash scripts/build-release-apk.sh",
    "distribute:android": "bash scripts/distribute-android.sh",
    "ship:android": "npm run release:android && npm run distribute:android"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "react-scripts": "5.0.1"
  },
  "proxy": "http://localhost:5000"
}
